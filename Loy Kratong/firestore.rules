rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helpers ----------------
    function isAnonUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function krathongPath(id) {
      return /databases/$(database)/documents/krathongs/$(id);
    }

    // ข้อความ: เป็น string, ความยาวตามกำหนด, ไม่ว่าง, ห้ามมี < หรือ >
    function isSafeText(s, maxLen) {
      return s is string
        && s.size() >= 1
        && s.size() <= maxLen
        && s.trim().size() >= 1
        && s.matches('[^<>]*');
    }

    function isValidKrathong(krathongId) {
      let d = request.resource.data;
      let fields = ['id', 'userId', 'ownerName', 'wishMessage', 'krathongType', 'flameColor',
                    'positionX', 'positionY', 'createdAt', 'status'];
      return d.keys().hasAll(fields)
        && d.keys().hasOnly(fields)
        && d.id == krathongId
        && d.userId == request.auth.uid
        && isSafeText(d.ownerName, 30)
        && isSafeText(d.wishMessage, 200)
        && d.krathongType in ['banana', 'lotus', 'marigold', 'bread', 'coconut']
        && d.flameColor in ['gold', 'pink', 'blue', 'green', 'purple']
        && d.positionX is number && d.positionX >= 0 && d.positionX <= 100
        && d.positionY is number && d.positionY >= 0 && d.positionY <= 100
        && d.createdAt == request.time
        && d.status == 'floating';
    }

    // ต้องอัปเดต users/{uid} (ตัวคุม rate limit) ใน batch เดียวกัน
    function userMetaUpdatedInSameBatch(krathongId) {
      let u = getAfter(userPath(request.auth.uid)).data;
      return u.lastKrathongAt == request.time && u.lastKrathongId == krathongId;
    }

    function isValidUserMeta() {
      let d = request.resource.data;
      return d.keys().hasOnly(['lastKrathongAt', 'lastKrathongId', 'count'])
        && d.lastKrathongAt == request.time
        && d.lastKrathongId is string
        && d.lastKrathongId.matches('[A-Za-z0-9]{20}')
        && !exists(krathongPath(d.lastKrathongId))
        && existsAfter(krathongPath(d.lastKrathongId))
        && getAfter(krathongPath(d.lastKrathongId)).data.userId == request.auth.uid;
    }

    function isValidStats() {
      let d = request.resource.data;
      return d.keys().hasOnly(['total', 'updatedAt'])
        && d.total is int
        && d.updatedAt == request.time
        && getAfter(userPath(request.auth.uid)).data.lastKrathongAt == request.time;
    }

    // ---------------- krathongs: อ่านได้ทุกคน, สร้างได้เฉพาะ Anonymous Auth ----------------
    match /krathongs/{krathongId} {
      allow read: if true;
      allow create: if isAnonUser()
        && isValidKrathong(krathongId)
        && userMetaUpdatedInSameBatch(krathongId);
      allow update, delete: if false;
    }

    // ---------------- users: Rate limit 1 กระทง / 20 วินาที ----------------
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if isAnonUser() && request.auth.uid == uid
        && isValidUserMeta()
        && request.resource.data.count == 1;
      allow update: if isAnonUser() && request.auth.uid == uid
        && isValidUserMeta()
        && request.resource.data.count == resource.data.count + 1
        && request.time > resource.data.lastKrathongAt + duration.value(20, 's');
      allow delete: if false;
    }

    // ---------------- stats/global: ตัวนับกระทงทั้งหมด (+1 ต่อกระทงจริงเท่านั้น) ----------------
    match /stats/{statId} {
      allow read: if true;
      allow create: if statId == 'global' && isAnonUser()
        && isValidStats() && request.resource.data.total == 1;
      allow update: if statId == 'global' && isAnonUser()
        && isValidStats() && request.resource.data.total == resource.data.total + 1;
      allow delete: if false;
    }

    // ---------------- presence: ผู้ใช้ออนไลน์ ----------------
    match /presence/{uid} {
      allow read: if true;
      allow create: if isAnonUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
      allow update: if isAnonUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time
        && request.time > resource.data.lastSeen + duration.value(10, 's');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // อื่น ๆ ปฏิเสธทั้งหมด (ค่าเริ่มต้น)
  }
}